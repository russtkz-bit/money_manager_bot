# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Web dashboard (webapp.py) — only needed if you run it ──

# Signs the web login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret; rotating it logs everyone out.
SESSION_SECRET=

# The public URL the dashboard is reachable at (e.g. your Cloudflare Tunnel
# hostname). Used only to put a clickable link in the /webcode message —
# the dashboard works without it, you'd just paste the URL in yourself.
WEB_BASE_URL=
