# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Web dashboard (webapp.py) — only needed if you run it ──

# Signs the web login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret; rotating it logs everyone out.
SESSION_SECRET=

# The public URL the dashboard is reachable at. Only needed for a Cloudflare
# *named* tunnel (a stable custom domain) — a *quick* tunnel's URL changes on
# every restart and is auto-detected instead (see CLOUDFLARED_METRICS_PORT).
# Used only to put a clickable link in the /webcode message; the dashboard
# works without it either way.
WEB_BASE_URL=

# Port cloudflared's local metrics server listens on — lets /webcode ask it
# for the current quick-tunnel URL instead of you tracking it by hand.
# Must match the --metrics port in money-tunnel.service (see
# deploy/WEBAPP_SETUP.md). Only relevant for quick tunnels; irrelevant if
# you're using a named tunnel with WEB_BASE_URL set. Default: 20241.
CLOUDFLARED_METRICS_PORT=20241
